# LiveKit Server Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional token API authentication boundary secret for frontend /api/token
LIVEKIT_TOKEN_AUTH_SECRET=

# Redis Authentication (Optional locally; recommended in production)
REDIS_PASSWORD=

# Speech-to-Text (Speaches / faster-whisper)
STT_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small

# Primary LLM (Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=not-needed

# Fallback LLM (Optional hosted OpenAI / Groq / OpenRouter)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=

# Text-to-Speech (Kokoro)
TTS_BASE_URL=http://localhost:8880/v1
TTS_MODEL=kokoro
TTS_VOICE=af_alloy

# Reliability & Concurrency
MAX_CALL_DURATION_SECONDS=300
NUM_IDLE_PROCESSES=2

# Privacy Settings (false: suppress transcript logs, true: enable for development/debugging)
LOG_TRANSCRIPTS=false

# Storage & Benchmarking
DB_PATH=voicedesk.db
METRICS_CSV=../benchmarks/results/metrics.csv

# LiveKit SIP & Telephony (Used when running with '--profile sip')
# Redis is accessed within the Docker network at redis:6379
# SIP service listens on port 5060 (UDP/TCP) and RTP range 20000-20200 (UDP)
# Restrict infra/sip/inbound-trunk.json allowed_addresses to trusted PBX/trunk CIDRs in production.
